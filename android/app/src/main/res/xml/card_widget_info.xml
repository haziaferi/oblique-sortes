<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is 0 on purpose. The platform floor is half an hour, and
    a card that changes on its own while you are looking at it is the opposite
    of what a card is for. It redraws when tapped, and not otherwise.

    minHeight is what the longest card needs, not what looks small. The card
    text autosizes down to 12sp, and at 12sp the 127-character card wraps to
    seven lines of 17.4dp at 180dp wide: 122dp of text, 28dp of padding, and
    the 48dp tap box of the deck name beneath it. A shorter floor cut long
    cards after two and a half lines with no ellipsis, since ellipsize fires
    only at maxLines.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/card_widget"
    android:minWidth="180dp"
    android:minHeight="200dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
